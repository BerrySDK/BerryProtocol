{
    "name": "berryprotocol",
    "version": "0.1.10",
    "description": "Facade package for Berry SDK that exposes BerryProtocol as the main SDK entrypoint.",
    "author": "Lipe Devv and Berry Protocol",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": "20.x || >=22 <27"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@berrysdk/core": "^0.1.10"
    }
}
